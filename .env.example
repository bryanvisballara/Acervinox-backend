PORT=3000
NODE_ENV=development
MONGODB_URI=
MONGO_USER=
MONGO_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_WORKSHOP_EMAIL=
SEED_WORKSHOP_PASSWORD=
RENDER_SERVICE_ID=
RENDER_SERVICE_URL=
RENDER_DEPLOY_HOOK=
VITE_API_URL=

# URL pública de la web (Hostinger). La app WebView apunta aquí para ver cambios al instante.
APP_ORIGIN=

# Push (Web Push VAPID). Generar con: node -e "import('web-push').then(m=>console.log(m.default.generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@acervinox.com
# Token FCM legado (opcional). Preferir la service account:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_SERVER_KEY=

# Wompi (abonos desde la app). Webhook: https://TU-API/api/payments/wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

